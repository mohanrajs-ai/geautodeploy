# ==============================================================================
# Cymbal Master Customer Onboarding — Named Module & Environment Configuration
# ==============================================================================
# Toggle any module (`true` or `false`) and run via the `gedeploy` CLI:
#   ./gedeploy --onboard --config ./configs/cymbal-onboard.env --dry-run
#   ./gedeploy --onboard --config ./configs/cymbal-onboard.env
# Or run any individual named module directly:
#   ./gedeploy --gcp-foundation --config ./configs/cymbal-onboard.env
#   ./gedeploy --entra-bootstrap --config ./configs/cymbal-onboard.env
#   ./gedeploy --m365-connectors --config ./configs/cymbal-onboard.env
#   ./gedeploy --ge-apps --config ./configs/cymbal-onboard.env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Cymbal Customer & GCP/Entra Parameters
# ------------------------------------------------------------------------------
CUSTOMER_NAME="cymbal"
CUSTOMER_DOMAIN="mohanrajs.demo.altostrat.com"
GCP_PROJECT_ID="cymbal-app-514110"
GCP_REGION="us-central1"
ENTRA_TENANT_ID="10a65113-9363-432b-bd99-a575f3337dd2"
DNS_PROJECT_ID="mohan-dns"
DNS_ZONE_NAME="mohanrajs-demo"
ENTRA_MODE="terraform"

# ServiceNow Instance Parameters (used when Phase 0D / Phase 2B are enabled)
SERVICENOW_INSTANCE_URI="https://gcpconnector3.service-now.com"
SERVICENOW_ADMIN_USER="admin"

# Atlassian Jira & Confluence Cloud Parameters (used when Phase 0E / Phase 2C are enabled)
ATLASSIAN_INSTANCE_URI="https://mohanrajs-team.atlassian.net"
ATLASSIAN_INSTANCE_ID="6ef6b83c-0038-4b28-941f-074fb11ea8c6"
ATLASSIAN_ADMIN_EMAIL="mohanraj@mohanrajs.demo.altostrat.com"

# ------------------------------------------------------------------------------
# 2. Onboarding Phase Toggles ("true" = Execute Phase, "false" = Skip Phase)
# ------------------------------------------------------------------------------

# Phase 0C: Enable GCP APIs & Create Versioned Remote Terraform State Bucket (gs://cymbal-ge-tfstate)
ENABLE_PHASE_0C_GCP_FOUNDATION="true"

# Phase 0B: Google Admin Console Bootstrap, Domain DNS TXT Verification & SAML SSO Profile (deploy_google_admin_bootstrap.sh)
ENABLE_PHASE_0B_GOOGLE_ADMIN="true"

# Phase 0A: Microsoft Entra ID OAuth App + 49 M365/DirectorySync Permissions + SAML Gallery App (deploy_entra_bootstrap.sh)
ENABLE_PHASE_0A_ENTRA_BOOTSTRAP="true"

# Phase 0D (Optional): ServiceNow Instance Bootstrap — Integration User, ITSM/KB/Catalog Roles, OAuth 2.0 Client & Secret Manager Sync (deploy_servicenow_bootstrap.sh)
ENABLE_PHASE_0D_SERVICENOW_BOOTSTRAP="false"

# Phase 0E (Optional): Atlassian Cloud Bootstrap — Tenant Cloud ID Discovery, OAuth 2.0 3LO & Secret Manager Sync (deploy_atlassian_bootstrap.sh)
ENABLE_PHASE_0E_ATLASSIAN_BOOTSTRAP="false"

# Phase 1A: GCP Directory Sync Connector Config, Group Reconciliation & GE License Sync (deploy_gcp_directory_sync.sh)
ENABLE_PHASE_1A_DIRECTORY_SYNC="true"

# Phase 1B: Cloud Identity Per-App Group Nesting & SAML Handshake via Terraform (deploy_identity.sh)
ENABLE_PHASE_1B_IDENTITY_TERRAFORM="true"

# Phase 1C (Optional): Sandbox CSV Group Membership Seeding (sync_group_members_from_csv.sh — keep false for GCP Directory Sync)
ENABLE_PHASE_1C_DEMO_CSV_SEED="false"

# Phase 2: Shared M365 Connectors — SharePoint, OneDrive, Outlook, Teams (deploy_m365.sh)
ENABLE_PHASE_2_M365_CONNECTORS="true"

# Phase 2B (Optional): Shared ServiceNow Connector — Knowledge Base, Incidents, Catalog Items & BAP Actions (deploy_servicenow.sh)
ENABLE_PHASE_2B_SERVICENOW_CONNECTOR="false"

# Phase 2C (Optional): Shared Atlassian Jira Cloud & Confluence Cloud Connectors & BAP Actions (deploy_atlassian.sh)
ENABLE_PHASE_2C_ATLASSIAN_CONNECTORS="false"

# Phase 3: Departmental Gemini Enterprise Apps — Dev Sandbox, Service Desk, Finance, HR (create_app_from_template.sh)
ENABLE_PHASE_3_GE_APPS="true"
# Optional comma-separated filter of App IDs to run in Phase 3 (leave empty to provision all 4 departmental apps):
# Example: PHASE_3_TARGET_APPS="cymbal-service-desk-app,cymbal-finance-app,cymbal-hr-app"
PHASE_3_TARGET_APPS=""

# Phase 4 (Optional): Deploy & Pin Universal ADK Skill Orchestrator across Gemini Enterprise Apps (publish_universal_agent.sh)
ENABLE_PHASE_4_UNIVERSAL_AGENT="false"
# Set to "true" to also build & deploy a new Vertex AI ReasoningEngine revision via `agents-cli deploy`,
# or "false" to only register/pin/share the existing ReasoningEngine across all Gemini Enterprise Apps:
PHASE_4_DEPLOY_REASONING_ENGINE="true"

# Phase 5 (Optional): 6-Rubric Benchmark Gate, GCS Catalog Upload & Multi-App Skill Sharing (publish_m365_skills.sh)
ENABLE_PHASE_5_SKILL_SHARING="false"
