# ==============================================================================
# Atlassian Jira Cloud & Confluence Cloud — Gemini Enterprise Connector Config
# ==============================================================================
# Copy this file to `configs/<customer>-atlassian.env` (or let Phase 0E
# `./deploy_atlassian_bootstrap.sh` generate it automatically) and run:
#   ./deploy_atlassian.sh --config ./configs/<customer>-atlassian.env
# ==============================================================================

# 1. Google Cloud & Discovery Engine Target
GCP_PROJECT_ID="cymbal-app-514110"
GCP_REGION="us-central1"
GE_LOCATION="global"
GE_IDENTITY_PROVIDER_TYPE="GSUITE"
TF_STATE_BUCKET="cymbal-ge-tfstate"

# 2. Secret Manager Credentials Reference
# Stores JSON: {instance_uri, instance_id, client_id, client_secret, refresh_token, user_account, api_token}
ATLASSIAN_SECRET_ID="cymbal-atlassian-connector-credentials"

# 3. Atlassian Cloud Site & Identity Parameters
ATLASSIAN_INSTANCE_URI="https://mohanrajs-team.atlassian.net"
# Cloud ID resolved from https://<domain>.atlassian.net/_edge/tenant_info
ATLASSIAN_INSTANCE_ID="6ef6b83c-0038-4b28-941f-074fb11ea8c6"
ATLASSIAN_ADMIN_EMAIL="mohanraj@mohanrajs.demo.altostrat.com"

# 4. Jira Cloud Connector Settings (Phase 2C)
ENABLE_JIRA_CONNECTOR="true"
JIRA_COLLECTION_ID="cymbal-jira-fed"
JIRA_COLLECTION_DISPLAY_NAME="Jira Cloud (cymbal)"
JIRA_CONNECTOR_MODE="FEDERATED"
JIRA_REFRESH_INTERVAL="86400s"
JIRA_ENTITIES="project,issue,comment,attachment,worklog"
ENABLE_JIRA_ACTIONS="true"
JIRA_ENABLED_ACTIONS="create_issue,update_issue,change_issue_status,create_comment,update_comment,upload_attachment"

# 5. Confluence Cloud Connector Settings (Phase 2C)
ENABLE_CONFLUENCE_CONNECTOR="true"
CONFLUENCE_COLLECTION_ID="cymbal-confluence-fed"
CONFLUENCE_COLLECTION_DISPLAY_NAME="Confluence Cloud (cymbal)"
CONFLUENCE_CONNECTOR_MODE="FEDERATED"
CONFLUENCE_REFRESH_INTERVAL="86400s"
CONFLUENCE_ENTITIES="space,page,blog,attachment,comment"
ENABLE_CONFLUENCE_ACTIONS="true"
CONFLUENCE_ENABLED_ACTIONS="create_page,update_page"

# 6. Target Gemini Enterprise Apps & Access Groups to Attach Jira & Confluence Data Stores
ATLASSIAN_TARGET_APPS="cymbal-dev-sandbox-app,cymbal-service-desk-app"
ATLASSIAN_ACCESS_GROUPS="ge-skill-developers@mohanrajs.demo.altostrat.com,ge-service-desk-users@mohanrajs.demo.altostrat.com"
ATLASSIAN_CONFIGURE_ACL="true"
